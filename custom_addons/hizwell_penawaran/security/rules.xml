<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Penawaran: ikut hak akses proyek induknya -->
    <record id="rule_penawaran_baca" model="ir.rule">
        <field name="name">Penawaran: baca sesuai hak akses proyek</field>
        <field name="model_id" ref="model_hizwell_penawaran"/>
        <field name="domain_force">[('proyek_id.akses_ids', 'any', [('user_id', '=', user.id)])]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_hizwell_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_penawaran_ubah" model="ir.rule">
        <field name="name">Penawaran: ubah jika akses proyek Mengubah</field>
        <field name="model_id" ref="model_hizwell_penawaran"/>
        <field name="domain_force">[('proyek_id.akses_ids', 'any', [('user_id', '=', user.id), ('tingkat_akses', '=', 'ubah')])]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_hizwell_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_penawaran_buat" model="ir.rule">
        <field name="name">Penawaran: buat (dicek hak Mengubah pada proyek di model)</field>
        <field name="model_id" ref="model_hizwell_penawaran"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_hizwell_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_penawaran_du" model="ir.rule">
        <field name="name">Penawaran: Direktur Utama semua</field>
        <field name="model_id" ref="model_hizwell_penawaran"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_direktur_utama'))]"/>
    </record>

    <!-- Baris barang: ikut penawaran induknya -->
    <record id="rule_penawaran_baris_baca" model="ir.rule">
        <field name="name">Baris penawaran: baca sesuai hak akses proyek</field>
        <field name="model_id" ref="model_hizwell_penawaran_baris"/>
        <field name="domain_force">[('penawaran_id.proyek_id.akses_ids', 'any', [('user_id', '=', user.id)])]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_hizwell_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_penawaran_baris_ubah" model="ir.rule">
        <field name="name">Baris penawaran: ubah jika akses proyek Mengubah</field>
        <field name="model_id" ref="model_hizwell_penawaran_baris"/>
        <field name="domain_force">[('penawaran_id.proyek_id.akses_ids', 'any', [('user_id', '=', user.id), ('tingkat_akses', '=', 'ubah')])]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_hizwell_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_penawaran_baris_du" model="ir.rule">
        <field name="name">Baris penawaran: Direktur Utama semua</field>
        <field name="model_id" ref="model_hizwell_penawaran_baris"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hizwell_base.group_direktur_utama'))]"/>
    </record>
</odoo>
