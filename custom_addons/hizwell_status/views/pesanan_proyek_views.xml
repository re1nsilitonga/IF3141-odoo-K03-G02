<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tab Status Dokumen pada form pesanan -->
    <record id="hizwell_pesanan_view_form_status" model="ir.ui.view">
        <field name="name">hizwell.pesanan.form.status</field>
        <field name="model">hizwell.pesanan</field>
        <field name="inherit_id" ref="hizwell_base.hizwell_pesanan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Status Dokumen" name="status_dokumen">
                    <button name="action_buat_status_dokumen" type="object" string="Buat Daftar Status"
                            class="btn-secondary" invisible="status_ids"/>
                    <field name="status_ids">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="jenis_dokumen" readonly="1"/>
                            <field name="status"/>
                            <field name="tanggal_pembaruan"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Stat button Daftar Periksa pada form proyek -->
    <record id="hizwell_proyek_view_form_daftar_periksa" model="ir.ui.view">
        <field name="name">hizwell.proyek.form.daftar.periksa</field>
        <field name="model">hizwell.proyek</field>
        <field name="inherit_id" ref="hizwell_base.hizwell_proyek_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_lihat_daftar_periksa" type="object" class="oe_stat_button" icon="fa-check-square-o">
                    <field name="daftar_periksa_count" widget="statinfo" string="Daftar Periksa"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>