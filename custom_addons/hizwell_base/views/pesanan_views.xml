<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hizwell_pesanan_view_tree" model="ir.ui.view">
        <field name="name">hizwell.pesanan.tree</field>
        <field name="model">hizwell.pesanan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="proyek_id"/>
                <field name="pelanggan_id"/>
                <field name="vendor_id"/>
                <field name="nomor_po_pelanggan"/>
                <field name="tanggal_pesanan"/>
            </tree>
        </field>
    </record>

    <record id="hizwell_pesanan_view_form" model="ir.ui.view">
        <field name="name">hizwell.pesanan.form</field>
        <field name="model">hizwell.pesanan</field>
        <field name="arch" type="xml">
            <form>
                <field name="bisa_ubah" invisible="1"/>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="proyek_id" readonly="id and not bisa_ubah"/>
                            <field name="pelanggan_id" readonly="id and not bisa_ubah"/>
                            <field name="vendor_id" readonly="id and not bisa_ubah"/>
                        </group>
                        <group>
                            <field name="nomor_po_pelanggan" readonly="id and not bisa_ubah"/>
                            <field name="tanggal_pesanan" readonly="id and not bisa_ubah"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hak Akses" name="hak_akses" groups="hizwell_base.group_direktur_utama">
                            <field name="akses_ids">
                                <tree editable="bottom">
                                    <field name="user_id"/>
                                    <field name="jabatan"/>
                                    <field name="tingkat_akses"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hizwell_pesanan_view_search" model="ir.ui.view">
        <field name="name">hizwell.pesanan.search</field>
        <field name="model">hizwell.pesanan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('nomor_po_pelanggan', 'ilike', self)]"/>
                <field name="proyek_id"/>
                <field name="pelanggan_id"/>
                <field name="vendor_id"/>
                <filter name="filter_arsip" string="Diarsipkan" domain="[('active', '=', False)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_proyek" string="Proyek" context="{'group_by': 'proyek_id'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hizwell_pesanan_action" model="ir.actions.act_window">
        <field name="name">Pesanan</field>
        <field name="res_model">hizwell.pesanan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buat pesanan pertama</p>
        </field>
    </record>
</odoo>