<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hizwell_hak_akses_view_tree" model="ir.ui.view">
        <field name="name">hizwell.hak.akses.tree</field>
        <field name="model">hizwell.hak.akses</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="user_id"/>
                <field name="jabatan"/>
                <field name="proyek_id"/>
                <field name="pesanan_id"/>
                <field name="tingkat_akses"/>
            </tree>
        </field>
    </record>

    <record id="hizwell_hak_akses_view_search" model="ir.ui.view">
        <field name="name">hizwell.hak.akses.search</field>
        <field name="model">hizwell.hak.akses</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="proyek_id"/>
                <field name="pesanan_id"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_user" string="Pengguna" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hizwell_hak_akses_action" model="ir.actions.act_window">
        <field name="name">Hak Akses Dokumen</field>
        <field name="res_model">hizwell.hak.akses</field>
        <field name="view_mode">tree</field>
    </record>
    
    <record id="hizwell_revisi_wizard_view_form" model="ir.ui.view">
        <field name="name">hizwell.revisi.wizard.form</field>
        <field name="model">hizwell.revisi.wizard</field>
        <field name="arch" type="xml">
            <form string="Buat Revisi">
                <p>Versi sekarang akan dipindahkan ke Arsip Revisi, lalu dibuat versi baru dengan nomor revisi berikutnya.</p>
                <group>
                    <field name="alasan" placeholder="Contoh: harga barang berubah sesuai klarifikasi pelanggan"/>
                </group>
                <footer>
                    <button name="action_buat" type="object" string="Buat Revisi" class="btn-primary"/>
                    <button string="Batal" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>