<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_po" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">hizwell.po</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hizwell_po_surat.report_po_dokumen</field>
        <field name="report_file">hizwell_po_surat.report_po_dokumen</field>
        <field name="print_report_name">'PO %s' % object.display_name</field>
    </record>

    <template id="report_po_dokumen">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">PURCHASE ORDER</h2>
                        <div class="row mt-4">
                            <div class="col-7">
                                <strong>Kepada (Vendor):</strong><br/>
                                <span t-field="doc.vendor_id.name"/><br/>
                                <div style="white-space: pre-line;" t-out="doc.alamat_vendor"/>
                            </div>
                            <div class="col-5">
                                <div><strong>Nomor PO:</strong> <span t-out="doc.nomor_dokumen"/></div>
                                <div t-if="doc.no_revisi"><strong>Revisi:</strong> <span t-out="doc.kode_revisi"/></div>
                                <div><strong>Tanggal:</strong> <span t-field="doc.tanggal_po"/></div>
                                <div><strong>Pesanan:</strong> <span t-out="doc.pesanan_id.name"/></div>
                            </div>
                        </div>

                        <p t-if="doc.no_revisi" class="mt-3">
                            <strong>Alasan revisi:</strong> <span t-out="doc.alasan_revisi"/>
                        </p>

                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Part Number</th>
                                    <th>Nama Barang</th>
                                    <th class="text-end">Jumlah</th>
                                    <th>Satuan</th>
                                    <th class="text-end">Harga Satuan</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.baris_ids" t-as="line">
                                    <tr>
                                        <td><t t-out="line_index + 1"/></td>
                                        <td><span t-out="line.part_number"/></td>
                                        <td><span t-out="line.nama_barang"/></td>
                                        <td class="text-end"><span t-out="line.jumlah"/></td>
                                        <td><span t-out="line.satuan"/></td>
                                        <td class="text-end"><span t-field="line.harga_satuan"/></td>
                                        <td class="text-end"><span t-field="line.subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr class="border-black">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><span t-field="doc.total"/></td>
                                    </tr>
                                    <tr t-if="doc.uang_muka_persen">
                                        <td>Uang muka (<span t-out="doc.uang_muka_persen"/>%)</td>
                                        <td class="text-end"><span t-field="doc.uang_muka_nominal"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div><strong>Incoterm:</strong>
                                <span t-out="dict(doc._fields['incoterm'].selection).get(doc.incoterm)"/>
                                <span t-if="doc.lokasi_incoterm">, <t t-out="doc.lokasi_incoterm"/></span>
                            </div>
                            <div t-if="doc.ketentuan_uang_muka" class="mt-2">
                                <strong>Ketentuan uang muka:</strong>
                                <div style="white-space: pre-line;" t-out="doc.ketentuan_uang_muka"/>
                            </div>
                        </div>

                        <div class="mt-5">
                            <p>Hormat kami,</p>
                            <br/><br/><br/>
                            <p><strong>Direktur Utama</strong><br/><span t-out="doc.company_id.name"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
