<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dokumen_view_tree" model="ir.ui.view">
        <field name="name">hizwell.dokumen.tree</field><field name="model">hizwell.dokumen</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="nama_berkas"/><field name="jenis_dokumen_id"/><field name="proyek_id"/><field name="pesanan_id"/></tree></field>
    </record>
    <record id="dokumen_view_form" model="ir.ui.view">
        <field name="name">hizwell.dokumen.form</field><field name="model">hizwell.dokumen</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="proyek_id"/><field name="pesanan_id"/><field name="jenis_dokumen_id" domain="[('lingkup', '=', 'proyek' if proyek_id else 'pesanan')]"/><field name="nama_berkas" invisible="1"/><field name="berkas" filename="nama_berkas" widget="binary"/></group></sheet></form>
        </field>
    </record>
    <record id="dokumen_view_search" model="ir.ui.view">
        <field name="name">hizwell.dokumen.search</field><field name="model">hizwell.dokumen</field>
        <field name="arch" type="xml"><search>
            <field name="name" string="Cari Dokumen" filter_domain="['|', ('name', 'ilike', self), ('nama_berkas', 'ilike', self)]"/>
            <field name="nama_berkas"/>
            <field name="proyek_id" string="Nomor Proyek" filter_domain="[('proyek_id.kode', 'ilike', self)]"/>
            <field name="pesanan_id" string="Nomor Pesanan" filter_domain="[('pesanan_id.name', 'ilike', self)]"/>
            <field name="jenis_dokumen_id"/>
            <group expand="0" string="Kelompokkan">
                <filter name="grup_proyek" string="Proyek" context="{'group_by':'proyek_id'}"/>
                <filter name="grup_pesanan" string="Pesanan" context="{'group_by':'pesanan_id'}"/>
            </group>
        </search></field>
    </record>
    <record id="action_dokumen" model="ir.actions.act_window">
        <field name="name">Dokumen</field><field name="res_model">hizwell.dokumen</field><field name="view_mode">tree,form</field>
    </record>
    <record id="proyek_form_dokumen" model="ir.ui.view">
        <field name="name">hizwell.proyek.form.dokumen</field><field name="model">hizwell.proyek</field>
        <field name="inherit_id" ref="hizwell_base.hizwell_proyek_view_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_lihat_dokumen" type="object" class="oe_stat_button" icon="fa-file-pdf-o">
                <field name="jumlah_dokumen" widget="statinfo" string="Dokumen"/>
            </button>
        </xpath></field>
    </record>
    <record id="pesanan_form_dokumen" model="ir.ui.view">
        <field name="name">hizwell.pesanan.form.dokumen</field><field name="model">hizwell.pesanan</field>
        <field name="inherit_id" ref="hizwell_base.hizwell_pesanan_view_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
            <button name="action_lihat_dokumen" type="object" class="oe_stat_button" icon="fa-file-pdf-o">
                <field name="jumlah_dokumen" widget="statinfo" string="Dokumen"/>
            </button>
        </xpath></field>
    </record>
</odoo>
